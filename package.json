{
  "name": "abyss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run pwacheck",
    "preview": "vite preview",
    "harness": "esbuild scripts/harness.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/harness.mjs --log-level=error && node node_modules/.cache/harness.mjs",
    "rendercheck": "esbuild scripts/rendercheck.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/rendercheck.mjs --log-level=error && node node_modules/.cache/rendercheck.mjs",
    "touchcheck": "esbuild scripts/touchcheck.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/touchcheck.mjs --log-level=error && node node_modules/.cache/touchcheck.mjs",
    "visualcheck": "esbuild scripts/visualcheck.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/visualcheck.mjs --log-level=error && node node_modules/.cache/visualcheck.mjs",
    "icons": "esbuild scripts/icons.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/icons.mjs --log-level=error && node node_modules/.cache/icons.mjs",
    "iconmatch": "esbuild scripts/iconmatch.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/iconmatch.mjs --log-level=error && node node_modules/.cache/iconmatch.mjs",
    "atlas": "esbuild scripts/atlas.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/atlas.mjs --log-level=error && node node_modules/.cache/atlas.mjs",
    "lpc": "esbuild scripts/lpc.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/lpc.mjs --log-level=error && node node_modules/.cache/lpc.mjs",
    "tiles": "esbuild scripts/tiles.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/tiles.mjs --log-level=error && node node_modules/.cache/tiles.mjs",
    "bolt": "esbuild scripts/bolt.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/bolt.mjs --log-level=error && node node_modules/.cache/bolt.mjs",
    "fx": "esbuild scripts/fx.ts --bundle --format=esm --platform=node --external:playwright --outfile=node_modules/.cache/fx.mjs --log-level=error && node node_modules/.cache/fx.mjs",
    "conceptcheck": "esbuild scripts/conceptcheck.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/conceptcheck.mjs --log-level=error && node node_modules/.cache/conceptcheck.mjs",
    "balancecheck": "esbuild scripts/harness.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/harness.mjs --log-level=error && esbuild scripts/harnessrun.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/harnessrun.mjs --log-level=error && esbuild scripts/balancecheck.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/balancecheck.mjs --log-level=error && node node_modules/.cache/balancecheck.mjs",
    "pwacheck": "esbuild scripts/pwacheck.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/pwacheck.mjs --log-level=error && node node_modules/.cache/pwacheck.mjs",
    "check": "tsc && npm run conceptcheck && npm run rendercheck && npm run touchcheck && npm run balancecheck"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
