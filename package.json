{
  "name": "abyss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bake": "python3 pipeline/bake_terrain.py",
    "check": "tsc",
    "tiles": "python3 pipeline/bake_tiles.py",
    "sprites": "python3 pipeline/bake_sprites.py",
    "synth": "python3 pipeline/synth_terrain.py",
    "npcs": "python3 pipeline/bake_npcs.py",
    "spawns": "python3 pipeline/spawn_npcs.py",
    "padcheck": "node scripts/padcheck.mjs",
    "viewcheck": "node scripts/viewcheck.mjs",
    "prompt": "python3 pipeline/make_prompt.py",
    "actions": "python3 pipeline/actions.py",
    "promptcheck": "python3 pipeline/make_prompt.py --check prompts/",
    "doll": "python3 pipeline/pack_paperdoll.py",
    "sources": "python3 pipeline/sources.py",
    "fetch": "python3 pipeline/fetch_assets.py",
    "catalogue": "python3 pipeline/catalogue.py",
    "ui": "python3 pipeline/bake_ui.py",
    "spells": "python3 pipeline/spells.py",
    "audit": "python3 pipeline/audit.py",
    "layout": "python3 pipeline/layout.py",
    "uicheck": "node scripts/uicheck.mjs",
    "quests": "python3 pipeline/quests.py",
    "questcheck": "node scripts/questcheck.mjs",
    "check:slow": "npm run viewcheck && npm run uicheck && npm run questcheck && npm run padcheck",
    "check:client": "npm run audit && npm run layout"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@types/three": "^0.185.4"
  },
  "description": "A single-player browser RPG built on AzerothCore data."
}
